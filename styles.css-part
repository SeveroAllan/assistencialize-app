/* --- Upgrade Overlay --- */
.upgrade-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(20, 20, 25, 0.7); /* Slightly darker semi-transparent bg */
    backdrop-filter: blur(8px); /* Glassmorphism effect */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100; /* Ensure on top of webview content */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.upgrade-overlay.visible {
    opacity: 1;
    pointer-events: all;
}

.upgrade-dialog {
    background-color: #2b2d31;
    padding: 30px;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid #3f4147;
    max-width: 400px;
    width: 90%;
}

.upgrade-dialog h2 {
    color: #e5e7eb;
    font-size: 18px;
    margin-bottom: 12px;
    font-weight: 700;
}

.upgrade-dialog p {
    color: #9ca3af;
    font-size: 14px;
    margin-bottom: 24px;
    line-height: 1.5;
}

.upgrade-btn {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
    border-style: solid;
    border-width: 1px;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
    text-decoration: none;
    display: inline-block;
}

.upgrade-btn:hover {
    background-color: #f0f0f0;
    transform: translateY(-2px);
}
